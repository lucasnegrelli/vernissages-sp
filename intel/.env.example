# URL pública do app (usada nos redirects do Stripe Checkout)
NEXT_PUBLIC_SITE_URL=https://intel.vernissagessp.com.br

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Supabase (Service Role — nunca expor no client)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx

# Segredo do cron semanal (Vercel injeta automaticamente como
# "Authorization: Bearer $CRON_SECRET" quando a env var existe)
CRON_SECRET=troque-por-uma-string-aleatoria-longa

# Quem recebe os avisos: cadastro, pagamento, atraso, cancelamento e o resumo
# de domingo (lib/avisar.ts). Sem ela, nenhum aviso é enviado.
OWNER_EMAIL=seu-email@exemplo.com

# Remetente. O domínio precisa estar verificado no Resend.
# Padrão se vazio: Vernissages SP: Intel <intel@vernissagessp.com.br>
INTEL_FROM=
